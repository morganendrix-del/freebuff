# Copy to .env (never commit real values). Loaded by Bun automatically.
# Every variable below is validated by packages/shared/src/config/env.ts.

NODE_ENV=development

# Platform metadata store (Postgres). docker compose up starts one.
DATABASE_URL=postgres://freebuff:freebuff@127.0.0.1:5432/freebuff_platform

# App-builder realtime backend (Convex deployment URL).
CONVEX_URL=

# Session signing secret (min 32 chars).
SESSION_SECRET=

# LLM provider credentials. Free tier defaults to DeepSeek.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub OAuth app for cloud-sandbox repo import and eject-to-GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://127.0.0.1:3000/api/auth/github/callback

# Phone OTP provider (Twilio-compatible).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sandbox orchestrator.
SANDBOX_HTTP_PORT=8788
SANDBOX_IMAGE=freebuff/sandbox:local

# Optional per-country free-tier hour overrides, JSON object of ISO country code -> hours.
# FREE_TIER_DAILY_HOURS_JSON={"US":30,"DE":8}
FREE_TIER_DAILY_HOURS_JSON=
